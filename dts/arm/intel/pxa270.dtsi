#include <mem.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "intel,xscale";
			reg = <0>;
			i-cache-line-size = <32>;
			d-cache-line-size = <32>;
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		intc: interrupt-controller@40d00000 {
			compatible = "intel,pxa2xx-intc";
			reg = <0x40d00000 0x1000>;
			interrupt-controller;
			#interrupt-cells = <2>;
			num-irqs = <34>;
			status = "okay";
		};

		ost: timer@40a00000 {
			compatible = "intel,pxa2xx-timer";
			reg = <0x40a00000 0x1000>;
			interrupts = <26 0>;
			interrupt-parent = <&intc>;
			clock-frequency = <3250000>;
			status = "disabled";
		};

		/* One node per 32-line bank, at that bank's GPLR */
		gpio0: gpio@40e00000 {
			compatible = "intel,pxa2xx-gpio";
			reg = <0x40e00000 0x4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <32>;
			status = "disabled";
		};

		gpio1: gpio@40e00004 {
			compatible = "intel,pxa2xx-gpio";
			reg = <0x40e00004 0x4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <32>;
			status = "disabled";
		};

		gpio2: gpio@40e00008 {
			compatible = "intel,pxa2xx-gpio";
			reg = <0x40e00008 0x4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <32>;
			status = "disabled";
		};

		/* GPIO96 to GPIO120 */
		gpio3: gpio@40e00100 {
			compatible = "intel,pxa2xx-gpio";
			reg = <0x40e00100 0x4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <25>;
			status = "disabled";
		};

		ssp1: spi@41000000 {
			compatible = "intel,pxa2xx-ssp";
			reg = <0x41000000 0x40>;
			cken-bit = <23>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		ssp2: spi@41700000 {
			compatible = "intel,pxa2xx-ssp";
			reg = <0x41700000 0x40>;
			cken-bit = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		ssp3: spi@41900000 {
			compatible = "intel,pxa2xx-ssp";
			reg = <0x41900000 0x40>;
			cken-bit = <4>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c0: i2c@40301680 {
			compatible = "intel,pxa2xx-i2c";
			reg = <0x40301680 0x24>;
			cken-bit = <14>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		/* The power manager's I2C, on its own pins */
		pwri2c: i2c@40f00180 {
			compatible = "intel,pxa2xx-i2c";
			reg = <0x40f00180 0x24>;
			cken-bit = <15>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			pwr-i2c;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		/*
		 * The three PXA UARTs are 16550 compatible, but with the
		 * registers spaced four bytes apart. They run off the 312 MHz
		 * peripheral PLL divided by 21.
		 */
		ffuart: uart@40100000 {
			compatible = "ns16550";
			reg = <0x40100000 0x100>;
			interrupts = <22 0>;
			interrupt-parent = <&intc>;
			reg-shift = <2>;
			clock-frequency = <14857142>;
			pxa-uart;
			status = "disabled";
		};

		btuart: uart@40200000 {
			compatible = "ns16550";
			reg = <0x40200000 0x100>;
			interrupts = <21 0>;
			interrupt-parent = <&intc>;
			reg-shift = <2>;
			clock-frequency = <14857142>;
			pxa-uart;
			status = "disabled";
		};

		stuart: uart@40700000 {
			compatible = "ns16550";
			reg = <0x40700000 0x100>;
			interrupts = <20 0>;
			interrupt-parent = <&intc>;
			reg-shift = <2>;
			clock-frequency = <14857142>;
			pxa-uart;
			status = "disabled";
		};
	};
};
