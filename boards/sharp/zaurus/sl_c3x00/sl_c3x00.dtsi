 *
 * Common to the PXA270 Zaurus clamshells SL-C3000 (Spitz), SL-C3100 (Borzoi)
 * and SL-C3200 (Terrier), laid out as Linux's spitz.c does: the same PXA270,
 * 64 MB of SDRAM in bank 0, FFUART, two SCOOP chips, the LCD and its timing
 * generator on SSP2, and the keyboard. The models differ in storage (NAND
 * size, microdrive), which nothing here touches. A board .dts includes this
 * and sets its own model and compatible.
 */

#include <arm/intel/pxa270.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/keymap.h>

/ {
	aliases {
		led0 = &green_led;
		led1 = &orange_led;
	};

	/*
	 * Both LEDs hang off the first SCOOP, active high, as in Linux's
	 * spitz.c: green is the "access" LED, orange the charge LED. QEMU
	 * prints these as "Green LED on/off" with the polarity inverted.
	 */
	leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&scoop1 0 GPIO_ACTIVE_HIGH>;
			label = "Green access LED";
		};

		orange_led: led_1 {
			gpios = <&scoop1 6 GPIO_ACTIVE_HIGH>;
			label = "Orange charge LED";
		};
	};

	/*
	 * The keyboard: eleven strobe (column) lines driven high one at a time,
	 * seven sense (row) lines read back high for a pressed key, as Linux's
	 * spitz.c sets up matrix-keypad. Unselected strobes float. The key
	 * interrupt is not wired up, so the matrix is polled.
	 */
	kbd: kbd-matrix {
		compatible = "gpio-kbd-matrix";
		row-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>,
			    <&gpio0 17 GPIO_ACTIVE_HIGH>,
			    <&gpio2 27 GPIO_ACTIVE_HIGH>,
			    <&gpio1 2 GPIO_ACTIVE_HIGH>,
			    <&gpio1 4 GPIO_ACTIVE_HIGH>,
			    <&gpio1 6 GPIO_ACTIVE_HIGH>,
			    <&gpio1 7 GPIO_ACTIVE_HIGH>;
		col-gpios = <&gpio2 24 GPIO_ACTIVE_HIGH>,
			    <&gpio0 23 GPIO_ACTIVE_HIGH>,
			    <&gpio0 24 GPIO_ACTIVE_HIGH>,
			    <&gpio0 25 GPIO_ACTIVE_HIGH>,
			    <&gpio0 26 GPIO_ACTIVE_HIGH>,
			    <&gpio0 27 GPIO_ACTIVE_HIGH>,
			    <&gpio1 20 GPIO_ACTIVE_HIGH>,
			    <&gpio3 7 GPIO_ACTIVE_HIGH>,
			    <&gpio3 11 GPIO_ACTIVE_HIGH>,
			    <&gpio3 12 GPIO_ACTIVE_HIGH>,
			    <&gpio3 18 GPIO_ACTIVE_HIGH>;
		idle-mode = "poll";
		settle-time-us = <10>;
		debounce-down-ms = <10>;
		debounce-up-ms = <20>;

		/*
		 * Linux's spitz_keymap. The keys without a PC equivalent use
		 * Linux's codes for them: F1 Calendar, F2 Address, F3 Fn,
		 * F4 Cancel, F5/F6 jog OK/Cancel, F7/F8 jog down/up, F9 Sync,
		 * F10 Mail, F11 OK, F12 Menu, LEFTALT/RIGHTCTRL the two
		 * Japanese input keys.
		 */
		keymap {
			compatible = "input-keymap";
			row-size = <7>;
			col-size = <11>;
			keymap = <
				MATRIX_KEY(0, 0, INPUT_KEY_LEFTCTRL)
				MATRIX_KEY(0, 1, INPUT_KEY_1)
				MATRIX_KEY(0, 2, INPUT_KEY_3)
				MATRIX_KEY(0, 3, INPUT_KEY_5)
				MATRIX_KEY(0, 4, INPUT_KEY_6)
				MATRIX_KEY(0, 5, INPUT_KEY_7)
				MATRIX_KEY(0, 6, INPUT_KEY_9)
				MATRIX_KEY(0, 7, INPUT_KEY_0)
				MATRIX_KEY(0, 8, INPUT_KEY_BACKSPACE)
				MATRIX_KEY(0, 9, INPUT_KEY_F5)
				MATRIX_KEY(0, 10, INPUT_KEY_F6)
				MATRIX_KEY(1, 1, INPUT_KEY_2)
				MATRIX_KEY(1, 2, INPUT_KEY_4)
				MATRIX_KEY(1, 3, INPUT_KEY_R)
				MATRIX_KEY(1, 4, INPUT_KEY_Y)
				MATRIX_KEY(1, 5, INPUT_KEY_8)
				MATRIX_KEY(1, 6, INPUT_KEY_I)
				MATRIX_KEY(1, 7, INPUT_KEY_O)
				MATRIX_KEY(1, 8, INPUT_KEY_P)
				MATRIX_KEY(1, 9, INPUT_KEY_F7)
				MATRIX_KEY(1, 10, INPUT_KEY_F8)
				MATRIX_KEY(2, 0, INPUT_KEY_TAB)
				MATRIX_KEY(2, 1, INPUT_KEY_Q)
				MATRIX_KEY(2, 2, INPUT_KEY_E)
				MATRIX_KEY(2, 3, INPUT_KEY_T)
				MATRIX_KEY(2, 4, INPUT_KEY_G)
				MATRIX_KEY(2, 5, INPUT_KEY_U)
				MATRIX_KEY(2, 6, INPUT_KEY_J)
				MATRIX_KEY(2, 7, INPUT_KEY_K)
				MATRIX_KEY(3, 0, INPUT_KEY_F2)
				MATRIX_KEY(3, 1, INPUT_KEY_W)
				MATRIX_KEY(3, 2, INPUT_KEY_S)
				MATRIX_KEY(3, 3, INPUT_KEY_F)
				MATRIX_KEY(3, 4, INPUT_KEY_V)
				MATRIX_KEY(3, 5, INPUT_KEY_H)
				MATRIX_KEY(3, 6, INPUT_KEY_M)
				MATRIX_KEY(3, 7, INPUT_KEY_L)
				MATRIX_KEY(3, 9, INPUT_KEY_RIGHTSHIFT)
				MATRIX_KEY(4, 0, INPUT_KEY_F1)
				MATRIX_KEY(4, 1, INPUT_KEY_A)
				MATRIX_KEY(4, 2, INPUT_KEY_D)
				MATRIX_KEY(4, 3, INPUT_KEY_C)
				MATRIX_KEY(4, 4, INPUT_KEY_B)
				MATRIX_KEY(4, 5, INPUT_KEY_N)
				MATRIX_KEY(4, 6, INPUT_KEY_DOT)
				MATRIX_KEY(4, 8, INPUT_KEY_ENTER)
				MATRIX_KEY(4, 9, INPUT_KEY_LEFTSHIFT)
				MATRIX_KEY(5, 0, INPUT_KEY_F10)
				MATRIX_KEY(5, 1, INPUT_KEY_Z)
				MATRIX_KEY(5, 2, INPUT_KEY_X)
				MATRIX_KEY(5, 3, INPUT_KEY_MINUS)
				MATRIX_KEY(5, 4, INPUT_KEY_SPACE)
				MATRIX_KEY(5, 5, INPUT_KEY_COMMA)
				MATRIX_KEY(5, 7, INPUT_KEY_UP)
				MATRIX_KEY(5, 10, INPUT_KEY_F3)
				MATRIX_KEY(6, 0, INPUT_KEY_SYSRQ)
				MATRIX_KEY(6, 1, INPUT_KEY_LEFTALT)
				MATRIX_KEY(6, 2, INPUT_KEY_RIGHTCTRL)
				MATRIX_KEY(6, 3, INPUT_KEY_F4)
				MATRIX_KEY(6, 4, INPUT_KEY_F11)
				MATRIX_KEY(6, 5, INPUT_KEY_F12)
				MATRIX_KEY(6, 6, INPUT_KEY_LEFT)
				MATRIX_KEY(6, 7, INPUT_KEY_DOWN)
				MATRIX_KEY(6, 8, INPUT_KEY_RIGHT)
			>;
		};
	};

	soc {
		/* Sharp SCOOP companion chips, on static chip selects 4 and 2 */
		scoop1: gpio@10800000 {
			compatible = "sharp,scoop";
			reg = <0x10800000 0x40>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <12>;
			status = "okay";
		};

		/* Backlight and IrDA controls */
		scoop2: gpio@8800040 {
			compatible = "sharp,scoop";
			reg = <0x08800040 0x40>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <12>;
			status = "okay";
		};
	};

	/*
	 * 64 MB of SDRAM in bank 0. The bottom 32 kB is left out of the image:
	 * that is where the Sharp boot loader parks its parameter block, and
	 * it is also where a Linux kernel would keep its page tables, so
	 * keeping the same hole makes the two interchangeable.
	 */
	sram0: memory@a0008000 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0xa0008000 (DT_SIZE_M(64) - 0x8000)>;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &ffuart;
		zephyr,shell-uart = &ffuart;
	};
};

/* Console on the serial lines of the docking connector. */
&ffuart {
	status = "okay";
	current-speed = <115200>;
};

&ost {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

/*
 * SSP2 carries the touch screen ADC, the LCD timing generator and the
 * battery ADC, each on its own GPIO chip select (Linux: spi2.0 to spi2.2).
 * The boot loader has already routed the SSP2 pins.
 */
&ssp2 {
	status = "okay";
	cs-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>,
		   <&gpio1 21 GPIO_ACTIVE_LOW>,
		   <&gpio0 20 GPIO_ACTIVE_LOW>;
};

/* WM8750 audio codec at 0x1b */
&i2c0 {
	status = "okay";
};

/* ISL6271A core voltage regulator at 0x0c */
&pwri2c {
	status = "okay";
};
