if BOARD_ZAURUS_SL_C3200

# Every loader on the machine boots a Linux zImage: kexec, kexecboot and
# QEMU's -kernel. zephyr.bin with the zImage header is one.
config BUILD_OUTPUT_BIN
	default y

config ARM_ZIMAGE_HEADER
	default y

config SYS_CLOCK_TICKS_PER_SEC
	default 1000

config BOARD_EARLY_INIT_HOOK
	default y

endif # BOARD_ZAURUS_SL_C3200
